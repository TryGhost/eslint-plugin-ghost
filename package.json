    "lint:test": "eslint -c test/.eslintrc.js test/ --ext .js --cache",
    "test": "node --test test/*.test.js",
    "posttest": "pnpm lint",
    "preship": "pnpm test",
    "ship": "pro-ship --publish"
  },
  "main": "lib/index.js",
  "peerDependencies": {
    "eslint": ">=5.11.0"
  },
  "devDependencies": {
    "@tryghost/pro-ship": "1.1.7",
