{
  "name": "eslint-plugin-ghost",
  "version": "4.0.1",
  "description": "Shared eslint configurations",
  "author": "Ghost Foundation",
  "homepage": "https://github.com/TryGhost/eslint-plugin-ghost",
  "repository": {
    "type": "git",
    "url": "git://github.com/TryGhost/eslint-plugin-ghost.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "scripts": {
    "lint:code": "eslint *.js lib/ --ext .js --cache",
    "lint": "pnpm lint:code && pnpm lint:test",
    "lint:test": "eslint -c test/.eslintrc.js test/ --ext .js --cache",
    "test": "node --test test/*.test.js",
    "posttest": "pnpm lint",
    "preship": "pnpm test",
    "ship": "pro-ship --publish"
  },
  "main": "lib/index.js",
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": ">=5.11.0",
    "typescript": ">=4.8.4"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-plugin-self": "1.2.1",
    "@tryghost/pro-ship": "1.1.9"
  },
  "license": "MIT",
  "dependencies": {
    "@kapouer/eslint-plugin-no-return-in-loop": "1.0.0",
    "eslint-plugin-filenames-ts": "1.3.2",
    "eslint-plugin-mocha": "7.0.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-sort-imports-es6-autofix": "0.6.0"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
