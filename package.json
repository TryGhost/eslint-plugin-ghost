{
  "name": "eslint-plugin-ghost",
  "version": "4.0.1",
  "description": "Shared eslint configurations",
  "author": "Ghost Foundation",
  "homepage": "https://github.com/TryGhost/eslint-plugin-ghost",
  "repository": {
    "type": "git",
    "url": "git://github.com/TryGhost/eslint-plugin-ghost.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "scripts": {
    "lint:code": "eslint *.js lib/ --ext .js --cache",
    "lint": "pnpm lint:code && pnpm lint:test",
    "lint:test": "eslint -c test/.eslintrc.js test/ --ext .js --cache",
    "test": "node --test test/*.test.js",
    "posttest": "pnpm lint",
    "preship": "pnpm test",
    "ship": "pro-ship --publish"
  },
  "main": "lib/index.js",
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": ">=5.11.0",
    "typescript": ">=4.8.4"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-plugin-self": "1.2.1",
    "@tryghost/pro-ship": "1.1.7"
  },
  "license": "MIT",
  "dependencies": {
    "@kapouer/eslint-plugin-no-return-in-loop": "1.0.0",
    "eslint-plugin-filenames-ts": "1.3.2",
    "eslint-plugin-mocha": "7.0.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-sort-imports-es6-autofix": "0.6.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
